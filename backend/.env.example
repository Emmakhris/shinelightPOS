# Copy to .env and edit (scripts\setup.ps1 creates one for you).
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=*
# SQLite (default, one or two tills):
# DATABASE_URL=sqlite:///C:/ShineLightPOS/backend/db.sqlite3
# PostgreSQL (recommended for several tills):
# DATABASE_URL=postgres://pos:password@localhost:5432/shinelightpos

# Paystack MoMo prompts (Paystack dashboard -> Settings -> API Keys & Webhooks).
# Paste your test key (starts with sk_test_) for test mode, your live key (sk_live_) for
# real money, or sk_fake for the offline simulator used in training.
# PAYSTACK_SECRET_KEY=
